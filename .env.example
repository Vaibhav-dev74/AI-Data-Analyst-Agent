# ==============================================================
# InsightIQ - AI-Powered Data Analyst Agent Environment Variables
# ==============================================================

# Application
PROJECT_NAME="InsightIQ Data Analyst Agent"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# Security & Authentication
# Generate a strong 32+ character random secret for production
SECRET_KEY="insightiq-super-secure-production-jwt-secret-key-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Default SQLite for instant local zero-setup dev. Use PostgreSQL/Supabase for production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/insightiq"
DATABASE_URL="sqlite:///./insightiq.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configuration
# Supported providers: "gemini", "openai", "mock" (offline fallback)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional OpenAI fallback
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
